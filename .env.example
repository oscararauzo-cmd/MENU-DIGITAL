# GEMINI_API_KEY: Required for Gemini AI API calls (Chaski AI assistant).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SUPABASE: Required for cloud PostgreSQL database & real-time iPad sync.
# Paste your Supabase Project URL and Anon Key here:
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
